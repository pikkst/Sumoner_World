// The slice path (quests spec §7, M2-16): after the Academy and the first creature, Memory Grove → Gathering Meadow →
// Bogfox Den, about 30 minutes. Offered in the quest log (J); titles until localization. Places: data/world/slice_region.json.
{
  "schemaVersion": 1,
  "kind": "quests",
  "entries": [
    {
      "id": "a_friend_in_the_clearing",
      "title": "The Memory Grove",
      "summary": "North of the Academy lies the Memory Grove. The creatures there remember how you treat them. Go and make friends.",
      "requires": ["a_first_friend"],
      "steps": [
        { "text": "Go north to the Memory Grove.", "objectives": [ { "type": "reach", "place": "the Memory Grove", "x": 256, "z": 296, "radius": 14 } ] },
        {
          "text": "Feed two creatures in the grove. Next time, watch how they look at you.",
          "objectives": [ { "type": "feed", "count": 2 } ]
        }
      ],
      "rewards": { "xp": 60, "gold": 10, "items": [ { "item": "sweetroot_bundle", "count": 1 } ] }
    },
    {
      "id": "berries_for_the_road",
      "title": "Berries for the Road",
      "summary": "A summoner never travels hungry. East of the grove lies the Gathering Meadow: pick sweet berries there (H).",
      "requires": ["a_friend_in_the_clearing"],
      "steps": [
        { "text": "Go east to the Gathering Meadow.", "objectives": [ { "type": "reach", "place": "the Gathering Meadow", "x": 306, "z": 300, "radius": 14 } ] },
        { "text": "Pick sweet berries from the bushes (H).", "objectives": [ { "type": "gather", "target": "sweet_berries", "count": 5 } ] }
      ],
      "rewards": { "xp": 40, "gold": 5, "items": [ { "item": "berry_meal", "count": 1 } ] }
    },
    {
      "id": "a_staff_of_your_own",
      "title": "A Staff of Your Own",
      "summary": "Gather fallen branches in the meadow and make a wooden staff (B opens crafting). You will want it at the den.",
      "requires": ["berries_for_the_road"],
      "steps": [
        { "text": "Gather fallen branches (H).", "objectives": [ { "type": "gather", "target": "fallen_branch", "count": 3 } ] },
        { "text": "Make a wooden staff and put it on (I).", "objectives": [ { "type": "craft", "target": "wooden_staff", "count": 1 } ] }
      ],
      "rewards": { "xp": 50, "gold": 10 }
    },
    {
      "id": "bogfox_trouble",
      "title": "The Bogfox Den",
      "summary": "A bogfox pack has made a den north-east of the meadow and snaps at travellers. Take your companion and face them.",
      "minLevel": 2,
      "requires": ["a_staff_of_your_own"],
      "steps": [
        { "text": "Find the Bogfox Den, north-east of the meadow.", "objectives": [ { "type": "reach", "place": "the Bogfox Den", "x": 338, "z": 352, "radius": 12 } ] },
        { "text": "Call your companion (Z) and defeat three bogfoxes of the den.", "objectives": [ { "type": "defeat", "target": "bogfox", "count": 3 } ] }
      ],
      "rewards": { "xp": 120, "gold": 25, "items": [ { "item": "sigil_ink", "count": 1 }, { "item": "mossback_charm", "count": 1 } ] }
    }
  ]
}
