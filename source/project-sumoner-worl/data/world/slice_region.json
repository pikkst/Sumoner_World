      "people": [
        {"id": "marta", "name": "Marta", "role": "innkeeper", "x": 180, "z": 293, "facing": 90, "robe": "#8f6a3f", "restPrice": 3, "shop": [{"item": "berry_meal", "price": 9}], "greeting": "Welcome to The Kept Promise! Sit down, you look like you walked a long way.", "lines": ["Every summoner in the Vale has slept under this roof at least once. Even the Headmaster, when he was young.", "Creatures have been going missing, they say. Men in grey cloaks were seen on the north road.", "Scout Rook comes in every evening. If anyone knows what is going on, it is Rook."]},
        {"id": "pell", "name": "Pell the Merchant", "role": "vendor", "x": 197, "z": 294, "facing": 270, "robe": "#4f6f8f", "shop": [{"item": "berry_meal", "price": 10}, {"item": "sigil_ink", "price": 20}, {"item": "sweetroot_bundle", "price": 14}], "buys": ["material"], "greeting": "Food, ink, a sturdy bag: Pell has what a summoner needs. Fair prices, mostly.", "lines": ["Sigil ink is dear these days. The ink-makers say the Binders buy it all.", "If you find raw ore in the Ash Fields, the smith pays well for it."]},
        {"id": "hadda", "name": "Hadda the Smith", "role": "vendor", "x": 192, "z": 313, "facing": 180, "robe": "#6a3f2f", "shop": [{"item": "wooden_staff", "price": 25}, {"item": "leather_vest", "price": 35}, {"item": "iron_staff", "price": 70}, {"item": "studded_vest", "price": 85}], "buys": ["ore", "horn", "tooth", "claw", "scale", "bone"], "greeting": "Mind the sparks. You want something made? Bring me the ore, I bring the arm.", "lines": ["A Dwarf taught me this trade. Forgemaster Dunrik, up at Emberdeep. Never smiled once.", "Iron collars came through here last month. I would not make them. Some smith did."]},
        {"id": "juniper", "name": "Juniper the Herbalist", "role": "vendor", "x": 178, "z": 307, "facing": 60, "robe": "#4f7f3f", "shop": [{"item": "sweet_berries", "price": 3}, {"item": "sweetroot", "price": 5}, {"item": "glowcap", "price": 5}], "buys": ["plant", "food"], "greeting": "Berries, roots, glowcaps from the fen: I buy what you gather and I sell what you need.", "lines": ["A glowcap eaten raw helps a tired body. Do not ask me why it glows.", "The mossbacks love sweetroot. Bring one and watch how a herd looks at you."]},
        {"id": "scout_rook", "name": "Scout Rook", "role": "story", "x": 190, "z": 284, "facing": 0, "robe": "#5a5a4a", "greeting": "You are the new summoner? Good. I could use another pair of eyes. Creatures are vanishing.", "lines": ["I found a mossback near the Memory Grove that did not know its own herd. Its eyes were empty.", "Grey cloaks, iron collars. The old stories call them Binders. I thought they were only stories."]},
        {"id": "old_tam", "name": "Old Tam", "role": "villager", "x": 186, "z": 300, "facing": 0, "robe": "#7a6a5a", "greeting": "Fine day. My knees say rain, but my knees say rain every day.", "lines": ["When I was a boy, the hollow owls nested in the town well. Clever birds. Rude, too.", "Be kind to the creatures, young one. They remember. Oh, they remember."], "route": [{"x": 186, "z": 300}, {"x": 200, "z": 304}, {"x": 196, "z": 318}, {"x": 182, "z": 314}]},
        {"id": "fenna", "name": "Fenna the Farmer", "role": "villager", "x": 205, "z": 286, "facing": 90, "robe": "#9f8f4f", "greeting": "Morning! I walk the fields up to the meadow every day. Never saw a bogfox stand so close before.", "lines": ["The bogfoxes leave my hens alone if I leave them a fish head. A fair deal.", "My sister lives in Fort Calder. She says the hounds there are the best friends a person can have."], "route": [{"x": 205, "z": 286}, {"x": 240, "z": 282}, {"x": 290, "z": 296}, {"x": 240, "z": 300}]},
        {"id": "watchman_orrin", "name": "Watchman Orrin", "role": "guard", "x": 214, "z": 312, "facing": 45, "robe": "#3f4f6f", "greeting": "Halt! Oh, a student. Go on then. Keep your creatures out of the flower boxes.", "lines": ["Nobody gets into Thornwick without me seeing. Except the cat. The cat gets in.", "If you head north to the Stormreach, take food. The wind up there eats you alive."]},
        {"id": "warden_sael", "name": "Warden Sael", "role": "mentor", "class": "elf", "x": 432, "z": 548, "facing": 180, "robe": "#3f7f4a", "shop": [{"item": "silverleaf_charm", "price": 50}], "greeting": "Welcome to Silverleaf Glade. If you are an Elf summoner, this is your home as much as mine.", "lines": ["Two calves of my herd are gone. Taken. I found marks of iron in the moss.", "The Elderwood is old and remembers everything. Walk softly in it."]},
        {"id": "captain_ilsa_varn", "name": "Captain Ilsa Varn", "role": "mentor", "class": "human", "x": 330, "z": 1138, "facing": 180, "robe": "#3f5f9f", "shop": [{"item": "hound_tag", "price": 50}], "greeting": "Fort Calder stands for duty and for the bond. State your business, summoner.", "lines": ["My old captain rode with us against the Covenant's last followers. Now I hear he leads the Binders.", "A hound will walk into fire for you. Make sure you never ask it to."]},
        {"id": "mother_wren", "name": "Mother Wren", "role": "mentor", "class": "necromancer", "x": 1150, "z": 368, "facing": 180, "robe": "#3a2f4f", "shop": [{"item": "lantern_charm", "price": 50}], "greeting": "Hush, the lanterns are listening. Come in, child of the living. You are welcome here.", "lines": ["Every lantern holds a spirit that chose to stay. One of them has forgotten its own name.", "We are not the shadow, whatever the songs say. We keep what others would forget."]},
        {"id": "forgemaster_dunrik", "name": "Forgemaster Dunrik", "role": "mentor", "class": "dwarf", "x": 1260, "z": 1248, "facing": 180, "robe": "#8f5f2f", "shop": [{"item": "ember_rune", "price": 50}], "buys": ["ore"], "greeting": "Emberdeep Gate. Wipe your boots. What is made well lasts, and that goes for summoners too.", "lines": ["Three hundred years ago our forges made the collars. We were lied to. We still pay for it.", "The Cold Forge has not burned since the Breaking. Something lives there now. Something angry."]}
      ]
    }
  ]
